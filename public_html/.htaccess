# ============================================================================
# .htaccess for premium static websites — copy as `.htaccess` to project root.
# Targets Apache (Hostinger default) and LiteSpeed.
# ============================================================================
#
# What this does:
# - HTML / JS / CSS / JSON: revalidate every visit (no stale code after deploy).
# - Images / fonts: cache 1 month (they change rarely; rename if needed).
# - MIME types: ensures Hostinger serves WebP and JS correctly.
# - Compression: gzip text assets when supported.
# - Security headers: minimal hardening.
#
# Doesn't work on Nginx VPS — those need server-level config.

# ----- Cache duration -----
<IfModule mod_expires.c>
  ExpiresActive On

  # Documents — never cache
  ExpiresByType text/html "access plus 0 seconds"

  # Code — cache largo (el cache-busting va por ?v= en el HTML)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/json "access plus 1 hours"

  # Media — cache long (use cache-busting filename if you change them)
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"

  # Fonts — cache long, immutable
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
</IfModule>

# ----- Cache-Control headers -----
<IfModule mod_headers.c>
  # HTML always fresh
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # JS / CSS: cache largo. El HTML pide los archivos con ?v=FECHA, así que al
  # cambiar esa versión el navegador descarga el archivo nuevo igual. Antes esto
  # era "no-cache" y obligaba a revalidar CSS y JS en CADA visita.
  <FilesMatch "\.(css|js|mjs)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # JSON: contenido que puede cambiar sin cambio de nombre — revalidar
  <FilesMatch "\.(json|webmanifest)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Images & fonts: long cache
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|avif|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Minimal security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

  # SEO-friendly headers for crawlers
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# ----- Correct MIME types (some shared hosts default wrong) -----
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType application/javascript .js
  AddType application/javascript .mjs
  AddType text/css .css
  AddType application/json .json
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType image/svg+xml .svg
  AddType text/xml .xml
  AddType text/plain .txt
</IfModule>

# ----- Gzip compression for text assets -----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml font/woff font/woff2
</IfModule>

# ----- Canonical: HTTPS + non-WWW en UN SOLO redirect -----
# El orden importa. Antes iba primero la regla de HTTPS y después la de www,
# así que http://www.stackbitcr.com daba DOS saltos:
#   http://www.dominio → https://www.dominio → https://dominio
# Poniendo la regla de www primero (y ya apuntando a https) se resuelve en uno.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Cualquier www → non-www, saltando directo a HTTPS
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L,NE]

  # 2) Ya es non-www: solo falta forzar HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L,NE]
</IfModule>

# ----- Redirecciones 301 de páginas eliminadas (agosto 2026) -----
# Estas URLs estuvieron publicadas e indexadas. Se redirigen a la página
# equivalente para no perder posicionamiento ni generar 404 a visitantes
# que lleguen desde Google o desde enlaces antiguos.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^paginas-web-restaurantes/?$      /servicios [R=301,L,NE]
  RewriteRule ^paginas-web-barberias/?$         /servicios [R=301,L,NE]
  RewriteRule ^tiendas-en-linea-costa-rica/?$   /servicios [R=301,L,NE]
  RewriteRule ^mantenimiento-web-costa-rica/?$  /servicios [R=301,L,NE]
  RewriteRule ^seo-costa-rica/?$                /servicios [R=301,L,NE]
  RewriteRule ^portafolio/?$                    /demos     [R=301,L,NE]
  RewriteRule ^blog/?$                          /           [R=301,L,NE]
  RewriteRule ^blog/.*$                         /           [R=301,L,NE]
</IfModule>

# ----- Pretty URLs (sin .html visible) -----
# Mostrar /servicios en vez de /servicios.html
# Mostrar / en vez de /index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  Options -MultiViews -Indexes +FollowSymLinks

  # 1) Redirect /index, /index.html → directorio limpio
  RewriteCond %{THE_REQUEST} \s/+(.*?/)?index(\.html)?[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # 2) Redirect /pagina.html → /pagina (301 permanente, NO se ve la extensión)
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # 3) Internamente: /pagina → servir /pagina.html (sin redirect, transparente)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ----- 404 personalizado -----
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 500 /404.html
